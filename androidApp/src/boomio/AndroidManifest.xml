<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Same sideload surface as `full`: the Boomio build self-updates from the fork's
         GitHub releases, so it needs to request package installs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Tier 1 LAN discovery browses mDNS, which the Wi-Fi stack drops unless a
         MulticastLock is held. Scoped to this flavor rather than `main` so the
         playstore build never claims it. `ACCESS_WIFI_STATE` (in `main`) is not
         sufficient on its own. Denial degrades to "browse without the lock". -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

</manifest>
